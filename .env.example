# ============================================================
# PyLearn Classroom — Environment Configuration (.env)
# ============================================================

# Port สำหรับรัน Server (ค่าเริ่มต้น 3000)
PORT=3000

# ============================================================
# 1. Supabase (PostgreSQL) Database Connection (URI)
# ============================================================
# นำมาจาก: Supabase Dashboard > Project Settings > Database > Connection String (URI)
# รูปแบบ: postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ============================================================
# 2. MySQL / TiDB Cloud Connection
# ============================================================
DB_TYPE=mysql

# 🌟 ตัวเลือก A: TiDB Cloud Serverless (MySQL Cloud ฟรีตลอดชีพ แนะนำที่สุด)
# พอร์ตของ TiDB Cloud คือ 4000 เสมอ
# MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=your_prefix.root
# MYSQL_PASSWORD=your_tidb_password
# MYSQL_DATABASE=pylearn
# MYSQL_SSL=true

# 💻 ตัวเลือก B: Local MySQL (XAMPP / Laragon บนเครื่อง)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=pylearn

# หรือใช้ Connection URI (ใส่แบบก้อนเดียว):
# MYSQL_URL=mysql://root:password@localhost:3306/pylearn

# ============================================================
# 3. Supabase API & Realtime Credentials (กรณีใช้ Supabase)
# ============================================================
# นำมาจาก: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# 3. AI Model Defaults (Optional)
# ============================================================
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
